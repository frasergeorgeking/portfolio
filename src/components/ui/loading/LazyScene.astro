---
interface Props {
	id: string;
	label: string;
	class?: string;
	contentClass?: string;
}

const { id, label, class: className, contentClass } = Astro.props;
---

<lazy-scene
	id={id}
	data-state="loading"
	class:list={["relative block", className]}
>
	<div
		data-loading
		class="absolute inset-0 z-10 flex flex-col justify-center gap-3 p-4 opacity-0 transition-opacity duration-200 sm:p-6"
		role="status"
		aria-live="polite"
	>
		<span class="sr-only">{label}</span>
		<div class="h-4 w-2/5 rounded bg-gray-200 dark:bg-neutral-700"></div>
		<div class="flex flex-col gap-3">
			<div class="h-3 w-full rounded bg-gray-200 dark:bg-neutral-700"></div>
			<div class="h-3 w-11/12 rounded bg-gray-200 dark:bg-neutral-700"></div>
			<div class="h-3 w-5/6 rounded bg-gray-200 dark:bg-neutral-700"></div>
			<div class="h-3 w-4/5 rounded bg-gray-200 dark:bg-neutral-700"></div>
		</div>
	</div>

	<div
		data-error
		class="absolute inset-0 z-10 hidden items-center justify-center p-6 text-center text-sm text-neutral-400"
		role="alert"
	>
		<slot name="error">Unable to load this interactive preview.</slot>
	</div>

	<div data-content class:list={["invisible h-full w-full", contentClass]}>
		<slot />
	</div>
</lazy-scene>

<script>
	import { connectLazyScene } from "@/components/ui/loading/sceneLifecycle";

	class LazySceneElement extends HTMLElement {
		private disconnect?: () => void;

		public connectedCallback() {
			this.disconnect?.();
			this.disconnect = connectLazyScene(this);
		}

		public disconnectedCallback() {
			this.disconnect?.();
			this.disconnect = undefined;
		}
	}

	if (!customElements.get("lazy-scene")) {
		customElements.define("lazy-scene", LazySceneElement);
	}
</script>
