---
import { getImage } from "astro:assets";
import LazyScene from "@/components/ui/loading/LazyScene.astro";
import fallbackCaseInner from "./assets/case-inner-empty-1.png";
import fallbackDiscBack from "./assets/disc-back-1.png";
import GameCaseCanvas from "./GameCaseCanvas";
import type { GameCaseSkin, GameCaseTextureUrls } from "./types";

interface Props {
	id: string;
	skin: GameCaseSkin;
	initialRotationY?: number;
	class?: string;
}

const { id, skin, initialRotationY, class: className } = Astro.props;
const resolvedSkin: Required<GameCaseSkin> = {
	...skin,
	caseInner: skin.caseInner ?? fallbackCaseInner,
	discBack: skin.discBack ?? fallbackDiscBack,
};
const skinEntries = Object.entries(resolvedSkin) as [
	keyof GameCaseSkin,
	ImageMetadata,
][];
const optimizedEntries = await Promise.all(
	skinEntries.map(async ([surface, src]) => {
		const image = await getImage({ src, format: "webp", quality: "high" });
		return [surface, image.src] as const;
	}),
);
const textureUrls = Object.fromEntries(optimizedEntries) as GameCaseTextureUrls;
---

<LazyScene
	id={id}
	label="Loading game case preview"
	class:list={["h-full min-h-[300px] w-full", className]}
>
	<GameCaseCanvas
		boundaryId={id}
		textureUrls={textureUrls}
		initialRotationY={initialRotationY}
		client:visible
	/>
</LazyScene>
